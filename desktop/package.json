{
  "name": "limited-ink-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Limited.Ink — Roblox Group Management Tool",
  "author": "Limited.Ink",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build:frontend": "node --import tsx build-frontend.ts",
    "build:server": "node --import tsx build-server.ts",
    "build:electron": "node --import tsx build-electron.ts",
    "build:all": "npm run build:frontend && npm run build:server && npm run build:electron",
    "pack": "npm run build:all && electron-builder --dir",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:mac": "npm run build:all && electron-builder --mac",
    "dist": "npm run build:all && electron-builder --win --mac",
    "dev": "node --import tsx build-server.ts && electron dist/main.js"
  },
  "dependencies": {
    "openai": "4.86.0",
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-session": "1.18.1",
    "jsonwebtoken": "9.0.2",
    "node-fetch": "3.3.2",
    "archiver": "7.0.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.15.0",
    "esbuild": "0.24.2",
    "electron": "33.3.1",
    "electron-builder": "25.1.8",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  },
  "build": {
    "appId": "com.limitedink.desktop",
    "productName": "Limited.Ink",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/frontend-src/**"
    ],
    "extraResources": [
      {
        "from": "dist/frontend",
        "to": "frontend"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "resources/icon.png",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
