modules = ["nodejs-24", "javascript", "postgresql-16"]
[deployment]
deploymentTarget = "autoscale"
run = ["node", "artifacts/api-server/dist/index.cjs"]
build = ["sh", "-c", "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/limited-ink run build && pnpm --filter @workspace/api-server run build"]
[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }
[[artifacts]]
id = "artifacts/api-server"
[[artifacts]]
id = "artifacts/limited-ink"
[[artifacts]]
id = "artifacts/mockup-sandbox"
[workflows]
[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
[userenv]
[userenv.shared]
JWT_SECRET = "c94dbee52472367936c8080323f119eaf52cdbc7c1828b65d77f4ba7be037331"
ADMIN_
[nix]
channel = "stable-25_05"